  "emphasis": {
    "pe": {
      "asks": "control or minority as stated, buyout or growth as stated, earnings quality, cash, debt, and downside",
      "does_not_ask": "seed follow-on reserves or a GP's fund terms",
      "monitor": "cash, debt, and whether the stated value-creation plan happened",
      "counterthesis": "earnings quality or debt service, not a different multiple on the same story"
    },
    "vc": {
      "asks": "stage, ownership, follow-on, and unit economics",
      "does_not_ask": "buyout debt or a manager's carry",
      "monitor": "follow-on reserve and whether unit economics moved since the last source",
      "counterthesis": "the next round needs follow-on the reserve does not cover, or unit economics that do not support it"
    },
    "hedge_fund": {
      "asks": "style, holding period, exposures, liquidity, catalysts, and what would falsify the book",
      "does_not_ask": "control buyout covenants or GP fundraising terms",
      "monitor": "exposures and liquidity as stated in a source, plus the catalyst clock",
      "counterthesis": "the other side of the exposure, or a catalyst that misses its clock"
    },
    "fund_selection": {
      "asks": "GP strategy, team, attribution, terms, and repeatability",
      "does_not_ask": "portfolio-company debt or venture unit economics unless a separate direct subprofile is the file you opened",
      "monitor": "manager reports, team changes, and terms, not the manager's underlying companies",
      "counterthesis": "attribution that is beta, or terms that take the stated edge"
    },
    "direct_public": {
      "asks": "the stated security, the stated horizon, and the constraint check",
      "does_not_ask": "private control covenants or GP fund terms",
      "monitor": "the stated horizon and whether a new source breaks the reason",
      "counterthesis": "the reason the security was filed, tested against a source that disagrees"
    },
    "credit": {
      "asks": "the stated claim on cash, downside, and what is skipped",
      "does_not_ask": "equity follow-on reserves or a long-short catalyst clock",
      "monitor": "covenants and cash only when a source states them",
      "counterthesis": "cash or priority that the thesis treats as safe"
    },
    "real_assets": {
      "asks": "the stated asset, the hold, and liquidity",
      "does_not_ask": "a hedge-fund book or a GP track record unless that subprofile is loaded",
      "monitor": "the hold and liquidity against the last source",
      "counterthesis": "liquidity or duration that the thesis ignores"
    },
    "other": {
      "asks": "only the focus written on this subprofile",
      "does_not_ask": "PE, VC, hedge-fund, or GP checklists that belong to another subprofile",
      "monitor": "whatever the focus names, and nothing borrowed from another strategy",
      "counterthesis": "a mechanism that contradicts the focus, not a generic risk paragraph"
    }
  },
  "workflow_order": [
    "screening",
    "thesis",
    "pe_diligence",
    "fund_diligence",
    "monitoring",
    "ic_memo",
    "decision_journal"
  ],
